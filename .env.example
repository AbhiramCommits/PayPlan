DJANGO_SECRET_KEY=dev-secret-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,web,api

# Host-facing URLs (make migrate / make test run on your machine).
# docker compose overrides these with the db/redis service names for containers.
DATABASE_URL=postgres://payplan:payplan@localhost:15432/payplan
REDIS_URL=redis://localhost:16379/0
CELERY_BROKER_URL=redis://localhost:16379/1
CELERY_RESULT_BACKEND=redis://localhost:16379/2

# fake (default, no network) or stripe (test mode only)
PAYMENT_GATEWAY=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

POSTGRES_USER=payplan
POSTGRES_PASSWORD=payplan
POSTGRES_DB=payplan
SEED_DEMO=1
